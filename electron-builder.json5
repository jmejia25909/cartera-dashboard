{
  appId: "com.mm.carteradashboard",
  productName: "Zenith Cartera",
  artifactName: "Zenith Cartera Setup ${version}.${ext}",
  copyright: "© 2026 Jhon Franklin Mejia Castro (RUC: 0950998104001). All rights reserved.",
  directories: {
    output: "release",
    buildResources: "build"
  },
  files: [
    "dist/**",
    "dist-electron/**",
    "package.json",
    "node_modules/**"
  ],
  extraResources: [
    { from: "build/icon.ico", to: "icon.ico" }
  ],
  asar: true,
  asarUnpack: [
    "node_modules/better-sqlite3/**",
    "node_modules/@ngrok/**"
  ],
  npmRebuild: true,
  win: {
    target: ["nsis"],
    icon: "build/icon.ico",
    signAndEditExecutable: true
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowElevation: true,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    installerIcon: "build/icon.ico",
    uninstallerIcon: "build/icon.ico",
    createDesktopShortcut: true,
    createStartMenuShortcut: true
  }
}

